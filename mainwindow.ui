    <string notr="true">
QWidget#centralwidget {
  color: #d8f6ff;
  font-family: &quot;Microsoft YaHei UI&quot;, &quot;Noto Sans CJK SC&quot;, &quot;Segoe UI&quot;;
}

QLabel {
  color: #d8f6ff;
  background: transparent;
}

QStackedWidget, QFrame, QWidget {
  background: transparent;
}

QGroupBox {
  color: #c8ecff;
  border: 1px solid rgba(58, 184, 232, 0.34);
  border-radius: 12px;
  margin-top: 16px;
  padding: 10px 8px 8px 8px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(9, 28, 48, 0.82),
                              stop:1 rgba(5, 17, 32, 0.72));
}
QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top center;
  padding: 2px 14px;
  color: #a8eaff;
  background: rgba(5, 18, 34, 0.96);
  border: 1px solid rgba(58, 184, 232, 0.36);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
}

QGroupBox#groupBox_4 {
  border: 1px solid rgba(255, 118, 118, 0.55);
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(70, 18, 20, 0.76),
                              stop:1 rgba(38, 11, 16, 0.70));
}
QGroupBox#groupBox_4::title {
  color: #ffd6d6;
  border: 1px solid rgba(255, 126, 126, 0.50);
  background: rgba(48, 13, 16, 0.96);
}
QGroupBox#groupBox_StepMove, QGroupBox#groupBox_SixAxies_StepMove {
  border: 1px solid rgba(56, 214, 255, 0.52);
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 rgba(8, 31, 56, 0.88),
                              stop:1 rgba(5, 20, 38, 0.78));
}

QToolButton, QPushButton {
  color: #eaf9ff;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(24, 76, 112, 0.82),
                              stop:1 rgba(10, 38, 66, 0.82));
  border: 1px solid rgba(72, 190, 238, 0.48);
  border-radius: 8px;
  padding: 5px 12px;
  min-height: 34px;
  font-weight: 700;
}
QToolButton:hover, QPushButton:hover {
  color: #ffffff;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(35, 105, 148, 0.92),
                              stop:1 rgba(13, 55, 88, 0.92));
  border: 1px solid #6fe7ff;
}
QToolButton:pressed, QPushButton:pressed, QToolButton:checked {
  background: rgba(0, 126, 186, 0.94);
  border: 1px solid #a8efff;
}
QToolButton:disabled, QPushButton:disabled {
  color: rgba(210, 230, 240, 0.42);
  background: rgba(28, 42, 54, 0.58);
  border: 1px solid rgba(120, 150, 170, 0.24);
}

QLineEdit, QComboBox, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  color: #f0fbff;
  background: rgba(3, 15, 28, 0.88);
  border: 1px solid rgba(74, 190, 238, 0.48);
  border-radius: 8px;
  padding: 5px 9px;
  selection-background-color: rgba(0, 176, 232, 0.72);
}
QLineEdit:hover, QComboBox:hover, QTextEdit:hover, QPlainTextEdit:hover {
  border: 1px solid rgba(128, 230, 255, 0.70);
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 1px solid #9ff4ff;
  background: rgba(4, 22, 40, 0.96);
}
QComboBox::drop-down {
  border: none;
  width: 24px;
}
QComboBox QAbstractItemView {
  color: #eaf9ff;
  background: #07192d;
  border: 1px solid rgba(74, 190, 238, 0.62);
  selection-background-color: rgba(0, 126, 186, 0.90);
}

QTableWidget {
  color: #eaf9ff;
  background: rgba(4, 18, 34, 0.84);
  alternate-background-color: rgba(10, 35, 58, 0.76);
  border: 1px solid rgba(74, 190, 238, 0.36);
  border-radius: 8px;
  gridline-color: rgba(78, 142, 176, 0.34);
  selection-background-color: rgba(0, 126, 186, 0.88);
}
QHeaderView::section {
  color: #a8eaff;
  background: rgba(9, 37, 64, 0.94);
  border: none;
  border-bottom: 1px solid rgba(74, 190, 238, 0.46);
  padding: 8px 12px;
  font-weight: 700;
}
QScrollBar:vertical, QScrollBar:horizontal {
  background: rgba(3, 15, 28, 0.72);
  border: none;
  margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: rgba(74, 190, 238, 0.48);
  border-radius: 4px;
  min-height: 24px;
}
QProgressBar {
  color: #eaf9ff;
  background: rgba(3, 15, 28, 0.78);
  border: 1px solid rgba(74, 190, 238, 0.42);
  border-radius: 7px;
  text-align: center;
}
QProgressBar::chunk {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 #0096d6,
                              stop:1 #4fe4ff);
  border-radius: 6px;
}

#TBtn_RemoveWarning {
  color: #fff4f4;
  background: rgba(132, 28, 30, 0.94);
  border: 1px solid #ff9a9a;
}
#TBtn_RemoveWarning:hover {
  background: rgba(186, 42, 42, 0.98);
  border: 1px solid #ffd6d6;
}

#groupBox_StepMove QLabel,
#groupBox_SixAxies_StepMove QLabel {
  color: #dff8ff;
  font-size: 13px;
  font-weight: 600;
}
#groupBox_StepMove QLineEdit,
#groupBox_SixAxies_StepMove QLineEdit {
  font-family: &quot;Consolas&quot;, &quot;Microsoft YaHei UI&quot;;
  font-size: 14px;
  font-weight: 700;
}

