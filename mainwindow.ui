   <string notr="true">QMainWindow {
    border-image: url(:/Picture/background9.png) 0 0 0 0 stretch stretch;
}
/* 保持中央控件透明，否则可能遮挡背景 */
QMainWindow &gt; QWidget {
    background: transparent;
}</string>
